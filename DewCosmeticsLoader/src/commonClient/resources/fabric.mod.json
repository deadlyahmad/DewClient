{
  "schemaVersion": 1,
  "id": "dewcosmetics",
  "version": "${version}",
  "name": "DewCosmetics",
  "description": "DewClient skins, capes, and wings with cross-version cosmetic sync.",
  "environment": "client",
  "entrypoints": {
    "client": ["fun.dewclient.cosmetics.DewCosmeticsClient"]
  },
  "mixins": [
    { "config": "dewcosmetics.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "java": ">=${java_version}"
  }
}
