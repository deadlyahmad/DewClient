# =========================================================================
# DewClient Central Server Configuration (Supabase Powered)
# =========================================================================

PORT=8787
HOST=127.0.0.1
NODE_ENV=production

# Supabase project URL and API keys (required).
# Get these from the project's Connect dialog or Settings -> API Keys.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_HTTP_TIMEOUT_MS=15000
SUPABASE_HTTP_RETRIES=2

# Legacy aliases are accepted during migration, but prefer the names above.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
# SUPABASE_ANON_KEY=your-legacy-anon-key

# Generate a unique secret with at least 32 random bytes; never share or commit it.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_SESSION_TTL_MS=28800000

# Encrypt cosmetic textures in the database at rest. Generate once with:
# openssl rand -hex 32
# Keep a protected backup; losing this key makes previously encrypted assets unrecoverable.
COSMETIC_ASSET_ENCRYPTION_KEY=

# Browser origins allowed to call the API. Electron file origins serialize as "null".
CORS_ORIGINS=null

# Enable only when a same-machine proxy overwrites X-Forwarded-For with $remote_addr.
# TRUST_PROXY=true

# Public HTTPS hostname used to construct release download URLs
PUBLIC_DOMAIN=server.example.com

# Use persistent disk storage for uploaded installer releases
DEWCLIENT_RELEASE_DIR=/var/lib/dewclient/releases

# Resend SMTP is configured in Supabase Dashboard > Authentication > SMTP Settings.
# Keep Resend credentials in Supabase's encrypted SMTP settings; do not put them here.

# Discord account linking for free cape claims. Keep the bot token only in the VPS
# server/.env file (never in the launcher, source archive, or chat).
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_APPLICATION_ID=1554555504410370149
# Discord OAuth2 Client Secret (different from the bot token).
# Add this exact URL to Discord Developer Portal > OAuth2 > Redirects:
# https://server.dewclient.fun/api/v1/auth/discord/callback
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=replace-with-a-regenerated-bot-token
DISCORD_LINK_GUILD_ID=1540800566303662254
DISCORD_LINK_CHANNEL_ID=1557123638501576805
# Optional: set after the first `npm run discord:publish-link-button` run.
DISCORD_LINK_MESSAGE_ID=
DISCORD_INVITE_URL=https://discord.gg/uXs2YD4D6H
